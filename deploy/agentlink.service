[Unit]
Description=AgentLink LAN message bus for AI agents
Documentation=https://github.com/you/AgentLink
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=agentlink
Group=agentlink
WorkingDirectory=/var/lib/agentlink
ExecStart=/usr/local/bin/agentlink --config /etc/agentlink/agentlink.json run
Restart=always
RestartSec=2

# Device/OS hardening (optional but recommended for a network daemon)
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/agentlink
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target